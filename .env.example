# =============================================
# VARIABLES DE ENTORNO - ÁLBUM VIRTUAL
# =============================================
# Copia este archivo como ".env" y rellena tus valores reales.
# NUNCA subas el archivo .env a GitHub.

# Puerto en el que correrá el servidor
PORT=3000

# URI de conexión a MongoDB
# Opción A - Local (si tienes MongoDB instalado en tu máquina):
MONGODB_URI=mongodb://localhost:27017/album_concierto

# Opción B - MongoDB Atlas (nube, recomendado para producción):
# MONGODB_URI=mongodb+srv://tuUsuario:tuPassword@tuCluster.mongodb.net/album_concierto

# Entorno de ejecución
NODE_ENV=development

# URL del frontend (para configurar CORS correctamente)
# En desarrollo puedes usar * para permitir todo
FRONTEND_URL=http://localhost:5173
